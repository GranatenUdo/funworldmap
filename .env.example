# Optional. Obtain a DSN by creating a project at https://sentry.io/.
# Leave empty in dev; set as a GitHub Actions secret named VITE_SENTRY_DSN for production builds.
VITE_SENTRY_DSN=

# Cloudflare Web Analytics site token. Paired to funworldmap.com on the CF dashboard.
# Leave empty in dev; set as a GitHub Actions secret for production builds.
# See docs/systems/analytics.md.
VITE_CF_WA_TOKEN=

# Cloudflare Worker analytics endpoint. Defaults empty in dev (track() becomes a no-op).
# Set to https://funworldmap.com/api/event for production builds.
# See docs/systems/analytics.md.
VITE_ANALYTICS_ENDPOINT=
