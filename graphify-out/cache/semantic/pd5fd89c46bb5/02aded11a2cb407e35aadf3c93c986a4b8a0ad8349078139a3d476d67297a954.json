    {
      "id": "docs_superpowers_plans_archive_2026_04_27_cross_component_state_and_game_over_fixes_module_store",
      "label": "Module-level store via useSyncExternalStore",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/archive/2026-04-27-cross-component-state-and-game-over-fixes.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Three critical bugs (missing share block, stale share data, cross-mode PB contamination) had one root cause: useDailyHistory and usePersonalBests each ran a local useState initializer reading localStorage once per hook instance, so two consumers held independent state and writes never propagated. The fix is one pattern \u2014 module-level snapshot plus listener set exposed as subscribe/getSnapshot/mutators \u2014 with the hook public APIs kept identical so no caller changes."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_27_cross_component_state_and_game_over_fixes_pb_flash_freeze",
      "label": "Freeze beatPersonalBest at first paint",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/archive/2026-04-27-cross-component-state-and-game-over-fixes.md",
      "source_location": "src/game/shared/hud/GameOverOverlay.tsx",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The store refactor makes the post-record() re-render MORE reliable, which makes the 'New PB!' flash worse rather than better \u2014 the overlay must additionally freeze the value in useState(initial) so it does not flip once the new best lands."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_27_cross_component_state_and_game_over_fixes_pb_hidden_on_daily",
      "label": "Personal bests hidden on daily game-over",
      "file_type": "concept",
      "source_file": "docs/superpowers/plans/archive/2026-04-27-cross-component-state-and-game-over-fixes.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A daily result is a fixed one-shot puzzle, so comparing it to a free-play personal best is meaningless and was also the vector for PB contamination."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_27_cross_component_state_and_game_over_fixes_hud_running_score",
      "label": "Running best-of-N score in the HUD",
      "file_type": "concept",
      "source_file": "docs/superpowers/plans/archive/2026-04-27-cross-component-state-and-game-over-fixes.md",
      "source_location": "src/game/shared/hud/ScoreBadge.tsx",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Players could not see what they were currently scoring mid-run; surfacing the running best makes the Done button a decision rather than a guess."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_27_cross_component_state_and_game_over_fixes_mode_switch_gameover",
      "label": "Mode switch from game-over via direct URL",
      "file_type": "concept",
      "source_file": "docs/superpowers/plans/archive/2026-04-27-cross-component-state-and-game-over-fixes.md",
      "source_location": "src/game/GameController.tsx",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The bootstrap refused to start a new session while in game-over, so navigating to the other mode's URL dead-ended on the finished overlay."
    }
  ],
