    {
      "id": "docs_superpowers_plans_archive_2026_04_26_game_flow_bugfix_plan",
      "label": "Game-flow bugfix Implementation Plan",
      "file_type": "document",
      "source_file": "docs/superpowers/plans/archive/2026-04-26-game-flow-bugfix.md",
