{
  "nodes": [
    {
      "id": "docs_superpowers_specs_2026_04_19_city_guessing_mode_design_city_guessing_mode_design",
      "label": "City Guessing Game Mode Design",
      "file_type": "document",
      "source_file": "docs/superpowers/specs/2026-04-19-city-guessing-mode-design.md",
      "source_location": null,
