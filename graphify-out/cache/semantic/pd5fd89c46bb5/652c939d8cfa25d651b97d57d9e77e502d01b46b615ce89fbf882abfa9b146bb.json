    {
      "id": "docs_superpowers_specs_2026_04_22_country_pinning_guess_fixes_and_ux_tooltip_suppression",
      "label": "Guess-Phase Tooltip Suppression",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-04-22-country-pinning-guess-fixes-and-ux.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Hovering a country revealed its name, invalidating the game. useMapInteractions reads useGameSessionContext directly rather than prop-drilling a flag, because the rule driving tooltip content is fundamentally a game-state concern. Highlight/extrusion/cursor behaviour is preserved."
    },
    {
      "id": "docs_superpowers_specs_2026_04_22_country_pinning_guess_fixes_and_ux_guessbyname_removal",
      "label": "GuessByNameButton Removal",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-04-22-country-pinning-guess-fixes-and-ux.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The typing input let players type the name already shown in the HUD. Only the UI is deleted \u2014 submitGuessInput stays because it is the universal guess path used by map clicks, the skip button, and the test shim."
    },
    {
      "id": "docs_superpowers_specs_2026_04_22_country_pinning_guess_fixes_and_ux_round_end_panel",
      "label": "Round-End Country Panel",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-04-22-country-pinning-guess-fixes-and-ux.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Rendered as a sibling JSX branch rather than by relaxing the existing !gameActive gate, because compare-related props are meaningless in-round and two clearly-named render sites read better than one branch full of conditionals."
    },
    {
      "id": "docs_superpowers_specs_2026_04_22_country_pinning_guess_fixes_and_ux_ingameround_prop",
      "label": "SingleCountryPanel inGameRound Prop",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-04-22-country-pinning-guess-fixes-and-ux.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Hides Compare and Copy-link and relabels Close to Continue; documented as in-round chrome only, with a note that a third in-round behaviour should trigger a refactor to a discriminated state object."
    },
    {
      "id": "docs_superpowers_specs_2026_04_22_country_pinning_guess_fixes_and_ux_continue_auto_advance",
      "label": "Continue / Auto-Advance Round-End Flow",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-04-22-country-pinning-guess-fixes-and-ux.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Wrong guesses wait for Continue so the panel is read; correct guesses auto-advance in 3000ms. Early-skip is scoped to Enter/Escape/Space plus the button \u2014 a window-level pointerdown would fire on clicks inside the panel and falsely advance."
    }
  ],
