    {
      "id": "docs_superpowers_plans_archive_2026_04_20_launcher_landing_state_last_mode",
      "label": "lastMode.ts storage helpers extracted before PlayMenu deletion",
      "file_type": "rationale",
      "rationale": "LAST_MODE_KEY and readLastMode lived inside PlayMenu; extracting them first keeps every intermediate commit compilable even though PlayMenu is deleted two phases later.",
