    {
      "id": "docs_superpowers_plans_archive_2026_04_20_launcher_landing_state_playmenu_removal",
      "label": "PlayMenu popover deleted in favour of the launcher",
      "file_type": "rationale",
      "rationale": "Two competing mode pickers would drift; the launcher becomes the single source of truth for mode selection.",
