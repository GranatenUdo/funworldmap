    {
      "id": "docs_superpowers_plans_archive_2026_04_20_launcher_landing_state_use_launcher_visibility",
      "label": "useLauncherVisibility hook",
      "file_type": "concept",
      "rationale": "Visibility is derived from window.location.hash plus session.status plus an in-memory dismissed flag; GameSessionContext is exported so tests can inject a mock API without booting real country/city pools.",
      "source_file": "docs/superpowers/plans/archive/2026-04-20-launcher-landing-state.md",
