    {
      "id": "docs_superpowers_specs_2026_04_27_game_flow_cascade_fixes_design_spec",
      "label": "Game-flow cascade fixes design",
      "file_type": "document",
      "source_file": "docs/superpowers/specs/2026-04-27-game-flow-cascade-fixes-design.md",
