    {
      "id": "docs_superpowers_plans_archive_2026_04_22_phase_5a_a11y_axe_pass_axe_wcag2aa_audit",
      "label": "axe-core WCAG 2 AA per-surface audit",
      "file_type": "concept",
      "source_file": "docs/superpowers/plans/archive/2026-04-22-phase-5a-a11y-axe-pass.md",
      "source_location": "e2e/accessibility.spec.ts",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "One AxeBuilder test per retention surface, extending the existing accessibility spec rather than forking a new e2e/a11y/ directory, so the established exclusion conventions stay in one place."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_22_phase_5a_a11y_axe_pass_per_surface_descope",
      "label": "Per-surface descope rule (>1 day restyle)",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/archive/2026-04-22-phase-5a-a11y-axe-pass.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "If a single surface needs more than a working day of restyle, disableRules is applied to THAT surface's test only, with a code comment and a roadmap entry naming the rule ID. The rule exists to bound open-ended iteration on violations whose real fix is a design-level palette change."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_22_phase_5a_a11y_axe_pass_maplibre_canvas_exclusion",
      "label": "MapLibre canvas + loading-splash axe exclusions",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/archive/2026-04-22-phase-5a-a11y-axe-pass.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The WebGL canvas is inherently opaque to axe's color-contrast probe, and the ephemeral z-[200] splash is aria-hidden + pointer-events-none but still scanned; both exclusions are justified rather than blanket rule suppression."
    },
    {
