      "id": "docs_superpowers_plans_archive_2026_04_22_phase_5a_a11y_axe_pass_gameover_contrast_backlog",
      "label": "GameOverOverlay warm-accent contrast backlog",
      "file_type": "concept",
      "source_file": "docs/superpowers/plans/archive/2026-04-22-phase-5a-a11y-axe-pass.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The surface with known pre-existing WCAG 2 AA violations deferred from the 2026-04-19 remediation; flagged as the most likely to hit the one-day descope threshold because the warm-accent palette fails contrast broadly."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_22_phase_5a_a11y_axe_pass_include_scoping",
      "label": "AxeBuilder .include() subtree scoping",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/archive/2026-04-22-phase-5a-a11y-axe-pass.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "For a component nested inside an already-audited surface, scoping axe to the block's subtree with .include() avoids re-reporting the surrounding surface's violations as noise."
    }
