    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_21_retention_program_v1_phase_2_daily_play_daily_puzzles_provider",
      "label": "DailyPuzzlesProvider context replacing a window-global hack",
      "file_type": "rationale",
      "rationale": "Hoisting useDailyPuzzles once at the app root lets Launcher and GameController share one fetch; it explicitly replaces the earlier plan's __funworldmap_daily window global.",
