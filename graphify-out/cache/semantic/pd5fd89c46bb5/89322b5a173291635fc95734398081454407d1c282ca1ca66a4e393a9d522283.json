      "contributor": null
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_21_retention_program_v1_phase_2_daily_play_intermediate_reveal",
      "label": "Intermediate attempt feedback that does not reveal the target",
      "file_type": "rationale",
      "rationale": "Intermediate attempts stay at status 'playing' with a transient currentAttempts[] array rather than firing round-ended; country mode highlights the guess in a warm accent and city mode shows a muted marker plus dashed line, withholding the answer until attempt 3 or revealEarly.",
      "source_file": "docs/superpowers/plans/archive/2026-04-21-retention-program-v1-phase-2-daily-play.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_21_retention_program_v1_phase_2_daily_play_daily_history",
      "label": "useDailyHistory + pure storage module with streak state machine",
      "file_type": "concept",
      "rationale": "Written once per completed daily on the transition into round-ended; the streak is evaluated at the same moment and stored but not displayed until Phase 3.",
      "source_file": "docs/superpowers/plans/archive/2026-04-21-retention-program-v1-phase-2-daily-play.md",
