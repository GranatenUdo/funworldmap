{
  "nodes": [
    {
      "id": "docs_superpowers_plans_archive_2026_04_22_retention_program_v1_phase_3_streak_calendar_plan",
      "label": "Retention v1 Phase 3 \u2014 Streak + Calendar + Reveal Plan",
      "file_type": "document",
      "source_file": "docs/superpowers/plans/archive/2026-04-22-retention-program-v1-phase-3-streak-calendar.md",
      "source_location": null,
