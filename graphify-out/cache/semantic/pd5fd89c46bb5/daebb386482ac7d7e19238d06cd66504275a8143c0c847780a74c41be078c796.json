    {
      "id": "docs_superpowers_plans_archive_2026_05_05_flake_triage_evidence_driven_fixes",
      "label": "Evidence-driven flake fixing (no blanket timeout bumps)",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/archive/2026-05-05-flake-triage.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Residual flakes are resolved by pulling CI traces and naming a root cause per failure, because blanket timeout increases and test rewrites both violate the repository's e2e rules and hide the assumption the test is actually making."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_05_05_flake_triage_dismisslauncher_wait",
      "label": "dismissLauncher waitForTimeout replaced with Header-attached wait",
      "file_type": "concept",
      "source_file": "docs/superpowers/plans/archive/2026-05-05-flake-triage.md",
      "source_location": "e2e/helpers.ts",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The project's last remaining sleep lived in a shared helper, so one fix removed the pattern from every spec that called it."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_05_05_flake_triage_tile_stub_investigation",
      "label": "routeMapTilesRich vs live basemap request investigation",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/archive/2026-05-05-flake-triage.md",
      "source_location": "e2e/helpers.ts",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Before choosing between dropping and extending the rich tile stub, the plan requires establishing what the stub actually fulfils versus what the light-theme positron basemap requests at runtime \u2014 the fix branches on that evidence rather than being pre-committed."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_05_05_flake_triage_panel_focus_hypotheses",
      "label": "panel-focus flake \u2014 three competing hypotheses",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/archive/2026-05-05-flake-triage.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Stale closure in the effect, mount-time race, or genuine CI slowness lead to different fixes (component-side vs test-side), so the CI trace is pulled to discriminate before any code changes."
    },
    {
      "id": "docs_superpowers_plans_archive_2026_05_05_flake_triage_five_green_watch",
      "label": "Five-consecutive-green CI watch as the done gate",
      "file_type": "concept",
      "source_file": "docs/superpowers/plans/archive/2026-05-05-flake-triage.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "An observational phase with a run log; flake work is not declared complete on a single pass because intermittent failures are by definition survivable once."
    }
  ],
