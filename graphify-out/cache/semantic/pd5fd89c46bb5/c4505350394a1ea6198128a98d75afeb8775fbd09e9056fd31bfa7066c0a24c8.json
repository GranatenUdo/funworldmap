      "contributor": null
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_17_chromium_gpu_on_linux_expect_poll",
      "label": "expect.poll on the real observable instead of waitForTimeout",
      "file_type": "rationale",
      "rationale": "Fixed waits calibrated against hardware ANGLE are too short under Linux software rendering; polling the actual post-action observable (hash change, cursor change, MapLibre idle) has identical semantics with no flake.",
      "source_file": "docs/superpowers/plans/archive/2026-04-17-chromium-gpu-on-linux.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_17_chromium_gpu_on_linux_serial_escape_hatch",
      "label": "describe.configure serial mode as a CPU-contention escape hatch",
      "file_type": "rationale",
      "rationale": "Two MapLibre instances rendering concurrently in software on a 4-core runner contend for CPU; serial mode confines the map spec to one worker without dropping global parallelism. Explicitly not to be applied preemptively.",
      "source_file": "docs/superpowers/plans/archive/2026-04-17-chromium-gpu-on-linux.md",
      "source_location": null,
