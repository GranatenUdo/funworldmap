    {
      "id": "docs_superpowers_specs_2026_05_19_daily_city_feedback_design_per_click_hud_text",
      "label": "Per-click HUD reveal line during play",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-19-daily-city-feedback-design.md",
      "source_location": "Item 1, CityGuessingHud",
      "source_url": null,
      "captured_at": null,
      "author": "Tobias Ens (with Claude)",
      "contributor": null,
      "rationale": "Attempts 1 and 2 of best-of-3 felt unregistered: a 10px marker held 600ms and a +pts toast gated on pointsEarned > 0 (which fails for far clicks scoring 0). Loosening the revealLine gate to include playing + best-of-N reads the latest attempt; the branches are mutually exclusive via the leading status check, so nothing double-renders."
    },
    {
      "id": "docs_superpowers_specs_2026_05_19_daily_city_feedback_design_persistent_marker",
      "label": "Persistent city intermediate click marker",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-19-daily-city-feedback-design.md",
      "source_location": "Item 2, useRevealMapEffects",
      "source_url": null,
      "captured_at": null,
      "author": "Tobias Ens (with Claude)",
      "contributor": null,
      "rationale": "Split the one intermediate-flash effect in two with distinct invariants. Country keeps its anchor ref (re-flashing an already-seen highlight on resume is noise); city deliberately has NO anchor because the marker is the current state of 'where you last clicked' \u2014 re-painting on resume restores it. Replace-only, never accumulate."
    },
    {
      "id": "docs_superpowers_specs_2026_05_19_daily_city_feedback_design_overlay_swap",
      "label": "Daily-city game-over renders DailyRevealOverlay",
      "file_type": "concept",
      "source_file": "docs/superpowers/specs/2026-05-19-daily-city-feedback-design.md",
      "source_location": "Item 3, GameController",
      "source_url": null,
      "captured_at": null,
      "author": "Tobias Ens (with Claude)",
      "contributor": null,
      "rationale": "A numeric GameOverOverlay with no city-name reveal read as 'ends abruptly'. Branch only on daily + city; daily-country and free play are byte-identical. Dual Escape handlers are kept deliberately \u2014 both are idempotent, and narrowing would regress Escape-to-close for the overlays that have no Esc handler of their own."
    }
  ],
