      "id": "docs_superpowers_plans_archive_2026_04_16_polish_keyboard_compare_hash_state",
      "label": "parseHash / writeHash pure URL-hash functions",
      "file_type": "concept",
      "rationale": "Extracted as pure functions so hash grammar is unit-testable in a Node environment without a browser; useSelectedCountry becomes a thin consumer.",
      "source_file": "docs/superpowers/plans/archive/2026-04-16-polish-keyboard-compare.md",
      "source_location": null,
      "source_url": null,
