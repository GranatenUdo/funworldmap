    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_16_polish_keyboard_compare_share_link",
      "label": "Share-link copy with clipboard fallback",
      "file_type": "concept",
      "rationale": "navigator.clipboard is only used under isSecureContext; otherwise a window.prompt fallback lets the user copy manually.",
