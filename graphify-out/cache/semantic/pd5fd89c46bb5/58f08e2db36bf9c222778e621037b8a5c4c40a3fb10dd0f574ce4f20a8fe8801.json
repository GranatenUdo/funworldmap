    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_16_polish_keyboard_compare_compare_mode",
      "label": "Country comparison mode (A vs B) with deep linking",
      "file_type": "concept",
      "rationale": "The compare pair rides in the same hash as the single selection (#FRA,DEU) so one grammar covers both share-link cases; picking mode is a distinct App-level state that reroutes onSelect.",
      "source_file": "docs/superpowers/plans/archive/2026-04-16-polish-keyboard-compare.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_16_polish_keyboard_compare_compare_layers",
      "label": "Compare map layers (glow, fill, border, extrusion) filtered by ccn3",
      "file_type": "concept",
      "rationale": "Layers are added once at init with an always-false filter and toggled by setFilter, avoiding add/remove churn; during compare viewing, hover opacity is locked to a constant so the B highlight is not disturbed.",
      "source_file": "docs/superpowers/plans/archive/2026-04-16-polish-keyboard-compare.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_16_polish_keyboard_compare_keyboard_shortcuts",
      "label": "Keyboard shortcuts with Escape priority cascade",
      "file_type": "concept",
      "rationale": "'/' focuses search unless the event target is already an input; Escape cascades exit-compare then close-panel then clear-search so one key always undoes the most recent state.",
      "source_file": "docs/superpowers/plans/archive/2026-04-16-polish-keyboard-compare.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_plans_archive_2026_04_16_polish_keyboard_compare_toast",
      "label": "Toast component driven by a global custom event",
      "file_type": "concept",
      "rationale": "The share button dispatches a window CustomEvent instead of threading a callback through the tree, keeping the panel decoupled from where the toast is mounted.",
      "source_file": "docs/superpowers/plans/archive/2026-04-16-polish-keyboard-compare.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
