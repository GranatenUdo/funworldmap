    {
      "id": "docs_superpowers_specs_2026_05_17_ux_smoothening_phase_2_design_spec",
      "label": "UX smoothening phase 2: composition polish + discoverability",
      "file_type": "document",
      "source_file": "docs/superpowers/specs/2026-05-17-ux-smoothening-phase-2-design.md",
      "source_location": null,
