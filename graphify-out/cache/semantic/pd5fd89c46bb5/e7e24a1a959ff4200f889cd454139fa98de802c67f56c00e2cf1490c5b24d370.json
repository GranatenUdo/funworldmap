      "id": "docs_superpowers_plans_archive_2026_05_13_verify_animations_and_share_share_branch_coverage",
      "label": "Share-button branch e2e coverage",
      "file_type": "rationale",
      "source_file": "docs/superpowers/plans/archive/2026-05-13-verify-animations-and-share.md",
      "source_location": null,
      "source_url": null,
