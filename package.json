{
  "name": "funworldmap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive political world map with country-pinning and city-guessing games. Fully client-side; deployable to any static host.",
  "homepage": "https://funworldmap.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/GranatenUdo/funworldmap.git"
  },
  "bugs": {
    "url": "https://github.com/GranatenUdo/funworldmap/issues"
  },
  "keywords": [
    "world-map",
    "geography",
    "maplibre",
    "react",
    "wcag-aa"
  ],
  "license": "MIT",
  "author": "Tobias Ens",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "bundle:budget": "npm run build && tsx scripts/bundle-budget/check.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "lint": "eslint src/ e2e/ scripts/",
    "format": "prettier --write src/",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "update-data": "tsx scripts/fetch-countries.ts",
    "fetch-cities": "tsx scripts/fetch-cities.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@sentry/react": "^10.53.1",
    "@vis.gl/react-maplibre": "^8.1.1",
    "fuse.js": "^7.3.0",
    "maplibre-gl": "^5.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.14",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.2",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.2.2",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,json,md,yml,yaml}": "prettier --write"
  }
}
